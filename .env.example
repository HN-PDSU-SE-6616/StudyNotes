# ============================================================
#   Taot 知识库 - 环境变量配置（本地运行：后端在本机，基础服务在容器）
#   复制为 .env 后按需修改
# ============================================================

# --- JWT 认证 ---
SECRET_KEY=your-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL（独立容器 postgres 已暴露 5432，infra.ps1 管理）---
DATABASE_URL=postgresql+asyncpg://postgresql:root@127.0.0.1:5432/StudyNote

# --- Qdrant 向量库（独立容器 qdrant 已暴露 6333）---
QDRANT_URL=http://127.0.0.1:6333

# --- Redis（独立容器 redis 已暴露 6379；Celery broker/result + 缓存）---
REDIS_URL=redis://127.0.0.1:6379/0

# --- 对象存储（LocalFS 根目录；S3/MinIO 预留）---
STORAGE_ROOT=storage

# --- Embedding（推荐：容器内 bge-small-zh 服务 6080:80，OpenAI 兼容接口带 key）---
# 本地直连容器服务，无需在宿主机安装 torch/sentence-transformers：
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=http://127.0.0.1:6080
# 若接口返回 404，说明服务 OpenAI 兼容路由挂在 /v1 下，改为：
# EMBEDDING_BASE_URL=http://127.0.0.1:6080/v1
EMBEDDING_API_KEY=your-embedding-service-key
# 容器内注册的模型名（非 HF 名，按服务实际模型名填写，如 bge-small-zh）
EMBEDDING_MODEL=bge-small-zh
# 预设仅用于推断维度/模型名：bge-small-zh=512；EMBEDDING_DIM 显式对齐更稳
EMBEDDING_PRESET=bge-small-zh
EMBEDDING_DIM=512
# 如需宿主机本地跑 sentence-transformers，改为：
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5（并先 uv sync --extra ai）
# 维度与 Qdrant collection 不一致时运行：uv run python scripts/rebuild_embeddings.py

# --- LLM（OpenAI 兼容接口，如 DeepSeek）---
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- CORS（list 字段需 JSON 数组字符串） ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- 旧版笔记数据目录（仅离线归档用，不再自动挂载）---
NOTES_DATA_PATH=data

# ============================================================
#   Taot 知识库 - 环境变量配置（本地开发默认值）
#   复制为 .env 后按需修改
# ============================================================

# --- JWT 认证 ---
SECRET_KEY=your-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL（docker compose 已暴露 5432）---
DATABASE_URL=postgresql+asyncpg://taot:taot@localhost:5432/taot

# --- Qdrant 向量库 ---
QDRANT_URL=http://localhost:6333

# --- Redis（Celery broker/result + 推荐缓存）---
REDIS_URL=redis://localhost:6379/0

# --- 对象存储（LocalFS 根目录；S3/MinIO 预留）---
STORAGE_ROOT=storage

# --- Embedding（sentence-transformers 模型名或本地路径；空则 RAG 相关功能关闭）---
EMBEDDING_MODEL=BAAI/bge-m3

# --- LLM（OpenAI 兼容接口，如 DeepSeek）---
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 旧版笔记数据目录（仅离线归档用，不再自动挂载）---
NOTES_DATA_PATH=data

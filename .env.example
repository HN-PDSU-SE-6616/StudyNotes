# ============================================================
#   Taot 知识库 - 环境变量配置文件
#   复制此文件为 .env 后修改（或直接使用默认值启动）
# ============================================================

# --- JWT 认证密钥（生产环境务必修改为随机字符串！）---
# 可使用 python -c "import secrets; print(secrets.token_hex(32))" 生成
SECRET_KEY=change-me-in-production-use-env-var

# JWT 签名算法
ALGORITHM=HS256

# Access Token 过期时间（分钟），默认 1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh Token 过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 数据库 ---
# SQLite 文件路径，默认项目根目录下的 blog.db
DATABASE_URL=sqlite+aiosqlite:///./blog.db

# --- CORS 允许的前端地址（多个地址用逗号分隔）---
# CORS_ORIGINS 暂不支持 .env 多值，请修改 app/core/config.py

# --- 旧版笔记数据目录（Wolai 导出的 HTML 笔记所在路径）---
# 新项目无此目录时无需设置，系统会跳过旧版笔记相关功能
NOTES_DATA_PATH=data
